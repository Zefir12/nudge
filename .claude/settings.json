{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make test:*)",
      "Bash(make lint)",
      "Bash(make lint:*)",
      "Bash(make format)",
      "Bash(make format:*)",
      "Bash(make tidy)",
      "Bash(make tidy:*)",
      "Bash(make web-build)",
      "Bash(make web-test)",
      "Bash(make web-check)",
      "Bash(make web-format)",
      "Bash(make build)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git rebase origin/develop)",
      "Bash(fj whoami)",
      "Bash(fj -H git.zefirlabs.net whoami)",
      "Bash(fj issue:*)",
      "Bash(fj pr view:*)",
      "Bash(fj pr create:*)",
      "Bash(fj pr comment:*)",
      "Bash(fj pr search:*)",
      "Bash(fj pr status:*)",
      "Bash(fj repo view:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin --delete:*)",
      "Bash(fj pr merge:*)",
      "Bash(fj auth:*)",
      "Bash(make publish:*)",
      "Bash(make push:*)",
      "Bash(docker push:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker stop:*)",
      "Bash(docker kill:*)",
      "Bash(docker system prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker image prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network rm:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.local/share/forgejo-cli/**)",
      "Read(~/.git-credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.sh"
          }
        ]
      }
    ]
  }
}
