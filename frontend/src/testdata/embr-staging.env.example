# Names only. The real values live in the nudge stack's .env, never in git.
# See docs/staging.md for what each one is and who sets it.
#
# The whole file reaches the app (env_file in compose.yaml), so the app settings use
# their ASP.NET Core names. Leave an optional setting out (or commented) rather than
# empty: an empty value overrides the default in appsettings.json, and an empty
# true/false or number fails startup. No `$` in values (compose reads them as variables).

# Set by every CI deploy (nudge deployment variable), pinned by digest:
# registrydedic.zefirlabs.net/embr@sha256:...
EMBR_IMAGE=

# Shared PostgreSQL instance: own database and user for staging. Npgsql format:
# Host=<host>;Port=5432;Database=embr_staging;Username=embr_staging;Password=...
ConnectionStrings__Default=
# Optional: how the PostgreSQL container is reached (see compose.yaml).
# - External (leave both out): Host is an IP or hostname; compose creates an empty
#   embr-staging-db network, nothing to pre-create.
# - Internal: DB_NETWORK is the existing Docker network of the PostgreSQL container
#   (`docker inspect <postgres container>`, under Networks), e.g. DB_NETWORK=postgres18_default
#   with DB_NETWORK_EXTERNAL=true, and Host is the container's name.
# DB_NETWORK=
# DB_NETWORK_EXTERNAL=

# First admin, created at startup while the users table is empty (docs/staging.md §6).
# Both or neither; the password needs at least 12 characters. Remove both once the admin
# exists.
Auth__BootstrapAdminEmail=
Auth__BootstrapAdminPassword=
# Auth__BootstrapAdminName=

# Required behind the reverse proxy: the proxy's address as the container sees it, so the
# login rate limit and logs see the client's IP and https (docs/prod.md "Client addresses").
# One of them, or both; more with __1, __2, ...
# ForwardedHeaders__KnownProxies__0=
# ForwardedHeaders__KnownNetworks__0=

# Recommended: the public origin (https://<staging hostname>). It replaces the dev origin
# (http://localhost:3999) from appsettings.json in the CORS and CSRF origin lists.
# Same-origin requests pass the CSRF check anyway.
# Frontend__Cors__Origins__0=

# Needed for the Expo app (README.md "Phone builds (EAS)"): its bearer-token login. Off, the
# app's POST /api/auth/token answers 404. The key is a secret of at least 32 bytes
# (openssl rand -base64 48), different from Jwt__Key; changing it signs the app out.
# AccountTokens__Enabled=true
# AccountTokens__Key=

# Optional: login with authestra (OIDC), backend/README.md "Login with authestra".
# Redirect URI to register in authestra: https://<staging hostname>/api/auth/callback
# Oidc__Enabled=
# Oidc__Authority=
# Oidc__ClientId=
# Oidc__ClientSecret=
# Oidc__PostLogoutRedirectUri=
# Oidc__AutoCreateUsers=
# Oidc__MapAdminRole=
# Oidc__AdminRole=

# Optional: Fitbit through the API (backend/README.md "Fitbit"). Redirect URI to register in the
# Fitbit app: https://<hostname>/api/fitbit/callback. Leave both empty to turn Fitbit off.
# Fitbit__ClientId=
# Fitbit__ClientSecret=

# Optional: DeepSeek for the training log's paste-to-parse (backend/README.md "Training log and
# DeepSeek"). A secret. Leave it empty to turn parsing off (503); the rest of training works.
# DeepSeek__ApiKey=

# Optional: meal photos (#194) in a Garage bucket (docs/api.md "Combos"). The keys are secrets; the
# bucket stays private (the API serves the photos). With Enabled=true every value is required.
# Photos__Enabled=true
# Photos__S3__ServiceUrl=
# Photos__S3__Region=garage
# Photos__S3__Bucket=
# Photos__S3__AccessKey=
# Photos__S3__SecretKey=

# Optional, staging only: the admin "Sync from Supabase" (docs/sync.md). It REPLACES the imported
# tables with Supabase's rows on every run. The connection string is a secret: a read-only role on
# Supabase, as a postgresql:// URI or Npgsql keywords, direct connection or session pooler, no "$"
# in the password. OwnerEmail gets the rows without an owner. Remove all three after the cut-over.
# SupabaseSync__Enabled=true
# SupabaseSync__ConnectionString=
# SupabaseSync__OwnerEmail=

# Optional: host:port the app is published on (default 127.0.0.1:8084).
# EMBR_PUBLISH=
